<odoo>
    <data>
        <record id="view_collaboration_info" model="ir.ui.view">
            <field name="name">hr.employee.collaboration.info</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='hr_settings']" position="after">
                    <page string="Collaboration Details" name="collaboration">


                        <group string="Collaboration Details">
                            <field name="collab_id" widget="form"
                                   context="{'form_view_ref': 'employee_details.collab_info_form'}"
                                   options="{'no_create_edit': False, 'no_create': False}"/>
                        </group>

                    </page>
                </xpath>
            </field>
        </record>


        <record id="collab_info_form" model="ir.ui.view">
            <field name="name">employee.collaboration.info.form</field>
            <field name="model">employee.collaboration</field>
            <field name="arch" type="xml">
                <form string="Collaboration">
                    <group>
                        <field name="details" />
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="organization"/>
                        <field name="country"/>
                        <field name="status"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="collab_info_list" model="ir.ui.view">
            <field name="name">employee.collaboration.info.list</field>
            <field name="model">employee.collaboration</field>
            <field name="arch" type="xml">
                <list string="Collaboration">
                        <field name="details" />
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="organization"/>
                        <field name="country"/>
                        <field name="status"/>
                </list>
            </field>
        </record>


<!--        view and form in configuration for collaboration status-->

         <record id="view_collaboration_tree" model="ir.ui.view">
            <field name="name">employee.status.collaboration.tree</field>
            <field name="model">status.collaboration</field>
            <field name="arch" type="xml">
                <list>
                    <field name="status"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="view_collaboration_form" model="ir.ui.view">
            <field name="name">employee.status.collaboration.form</field>
            <field name="model">status.collaboration</field>
            <field name="arch" type="xml">
                <form string="Qualification">
                    <group>
                        <field name="status"/>
                        <field name="description"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_collaboration_info" model="ir.actions.act_window">
            <field name="name">Collaboration</field>
            <field name="res_model">status.collaboration</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create the qualification record for employees.</p>
            </field>
        </record>

        <menuitem id="menu_collaboration_info"
                  name="Collaboration Status"
                  parent="hr.menu_human_resources_configuration"
                  action="action_collaboration_info"
                  sequence="1"/>




    </data>
</odoo>
