<odoo>
    <data>
        <record id="view_it_report_from" model="ir.ui.view">
            <field name="name">IT Report</field>
            <field name="model">it.report</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_it_report_list" model="ir.ui.view">
            <field name="name">IT Report</field>
            <field name="model">it.report</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="action_it_report" model="ir.actions.act_window">
            <field name="name">IT Report</field>
            <field name="res_model">it.report</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
                id="it_report_menu"
                parent="hr.menu_human_resources_configuration"
                name="IT Report"
                action="action_it_report"
                sequence="30"/>

    </data>
</odoo>
