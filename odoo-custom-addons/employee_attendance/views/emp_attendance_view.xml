<odoo>
    <data>
        <record id="attendance_inherit_form_view" model="ir.ui.view">
            <field name="name">attendance.inherit.form.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[last()]" position="before">
                    <page string="Attendance">
                        <field name="attendances" readonly="1"/>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="contract_inherit_form_view" model="ir.ui.view">
            <field name="name">contract.inherit.form.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[last()]" position="before">
                    <page string="Contracts">
                        <field name="contracts" readonly="1"/>
                    </page>
                </xpath>
            </field>
        </record>

