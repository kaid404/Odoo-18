<odoo>
    <data>

        <record id="ride_sales_summary_report_form" model="ir.ui.view">
            <field name="name">ride.sales.summary.report.form</field>
            <field name="model">ride.sales.summary.report</field>
            <field name="arch" type="xml">
                <form string="Ride Sales Summary Report">
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="session_id"/>
                            <field name="category_id"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Generate Report" type="object" name="generate_ride_sales_summary_report"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_ride_sales_summary_report" model="ir.actions.act_window">
            <field name="name">Ride Sales Summary Report</field>
            <field name="res_model">ride.sales.summary.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
                id="menu_ride_sales_summary_report_wizard"
                name="Ride Sales Summary Report"
                parent="point_of_sale.menu_point_rep"
                action="action_ride_sales_summary_report"
        />

    </data>
</odoo>
