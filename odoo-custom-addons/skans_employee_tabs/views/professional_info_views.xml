<odoo>
    <data>

        <record id="form_view_professional_info" model="ir.ui.view">
            <field name="name">form_view_professional_info</field>
            <field name="model">professional.info</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="emp_is_military_course"/>
                            <field name="emp_name_in_personal_qualification"/>
                            <field name="emp_certification_status"/>
                            <field name="emp_institute_name"/>
                        </group>
                        <group>
                            <field name="emp_country_name"/>
                            <field name="emp_from_date"/>
                            <field name="emp_to_date"/>
                            <field name="emp_remarks_field"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>


        <record id="list_view_professional_info" model="ir.ui.view">
            <field name="name">list_view_professional_info</field>
            <field name="model">professional.info</field>
            <field name="arch" type="xml">
                <list>
                    <field name="emp_is_military_course"/>
                    <field name="emp_name_in_personal_qualification"/>
                    <field name="emp_certification_status"/>
                    <field name="emp_institute_name"/>
                    <field name="emp_country_name"/>
                    <field name="emp_from_date"/>
                    <field name="emp_to_date"/>
                    <field name="emp_remarks_field"/>
                </list>
            </field>
        </record>

        <record id="form_view_verification_info" model="ir.ui.view">
            <field name="name">form_view_verification_info</field>
            <field name="model">body.verification.details</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="emp_body_verification_status"/>
                        <field name="emp_body_verification_date"/>
                        <field name="emp_body_verification_remarks"/>
                    </group>
                </form>
            </field>
        </record>


        <record id="list_view_verification_info" model="ir.ui.view">
            <field name="name">list_view_verification_info</field>
            <field name="model">body.verification.details</field>
            <field name="arch" type="xml">
                <list>
                    <field name="emp_body_verification_status"/>
                    <field name="emp_body_verification_date"/>
                    <field name="emp_body_verification_remarks"/>
                </list>
            </field>
        </record>


