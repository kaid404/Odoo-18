<odoo>
    <data>

        <record id="form_view_disciplinary_action_type" model="ir.ui.view">
            <field name="name">form_view_disciplinary_action_type</field>
            <field name="model">disciplinary.action</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="disc_action_type_name"/>
                    </group>
                </form>
            </field>
        </record>


        <record id="list_view_disciplinary_action_type" model="ir.ui.view">
            <field name="name">list_view_disciplinary_action_type</field>
            <field name="model">disciplinary.action</field>
            <field name="arch" type="xml">
                <list>
                    <field name="disc_action_type_name"/>
                </list>
            </field>
        </record>

        <record id="action_disciplinary_action_type" model="ir.actions.act_window">
            <field name="name">Disciplinary Action Type</field>
            <field name="res_model">disciplinary.action</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create Action Type  for Disciplinary Records.</p>
            </field>
        </record>

        <menuitem id="menu_discipline_action"
                  name="Discipline Type"
                      parent="hr.menu_human_resources_configuration"
                  action="action_disciplinary_action_type"
                  sequence="10"/>


