<odoo>
    <data>

        <record id="form_view_project" model="ir.ui.view">
            <field name="name">Projects</field>
            <field name="model">projects.info</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="emp_type_project_list"/>
                            <field name="emp_position_list"/>
                            <field name="emp_status_list"/>
                            <field name="emp_remuneration"/>
                            <field name="emp_project_funded"/>
                            <field name="emp_project_total"/>
                        </group>
                        <group>
                            <field name="emp_funding_agency"/>
                            <field name="emp_funded_amount"/>
                            <field name="emp_project_date_from"/>
                            <field name="emp_project_date_to"/>
                            <field name="emp_project_url"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>


        <record id="list_view_project" model="ir.ui.view">
            <field name="name">Projects Summary</field>
            <field name="model">projects.info</field>
            <field name="arch" type="xml">
                <list>
                    <field name="emp_type_project_list"/>
                    <field name="emp_position_list"/>
                    <field name="emp_status_list"/>
                    <field name="emp_remuneration"/>
                    <field name="emp_project_funded"/>
                    <field name="emp_project_total"/>
                    <field name="emp_funding_agency"/>
                    <field name="emp_funded_amount"/>
                    <field name="emp_project_date_from"/>
                    <field name="emp_project_date_to"/>
                    <field name="emp_project_url"/>
                </list>
            </field>
        </record>


