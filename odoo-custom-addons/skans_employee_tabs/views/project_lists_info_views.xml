<odoo>
    <data>
        <!-- List View -->
        <record id="view_type_list_info_tree" model="ir.ui.view">
            <field name="name">view.type.list.info.tree</field>
            <field name="model">type.project</field>
            <field name="arch" type="xml">
                <list>
                    <field name="project_type_name"/>
                    <field name="project_type_desc"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_type_list_info_form" model="ir.ui.view">
            <field name="name">Type List</field>
            <field name="model">type.project</field>
            <field name="arch" type="xml">
                <form string="Type List">
                    <group>
                        <field name="project_type_name"/>
                        <field name="project_type_desc"/>

                    </group>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_type_list_info" model="ir.actions.act_window">
            <field name="name">Type</field>
            <field name="res_model">type.project</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create Type List for Projects.</p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_type_list_info"
                  name="Project Types"
                  parent="hr.menu_human_resources_configuration"
                  action="action_type_list_info"
                  sequence="10"/>





