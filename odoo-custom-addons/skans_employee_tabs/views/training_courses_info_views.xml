    <data>

        <record id="form_view_training_courses" model="ir.ui.view">
            <field name="name">Training Courses</field>
            <field name="model">training.courses</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="emp_type_list_training_courses"/>
                            <field name="emp_tc_name"/>
                            <field name="emp_tc_date_from"/>
                            <field name="emp_tc_date_to"/>
                        </group>
                        <group>
                            <field name="emp_tc_center"/>
                            <field name="emp_tc_organize_by"/>
                            <field name="emp_tc_organizing_body"/>
                            <field name="emp_tc_sponsored_by"/>
                            <field name="emp_tc_sponsored_body"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>


        <record id="list_view_training_courses" model="ir.ui.view">
            <field name="name">Training Courses</field>
