<odoo>
    <data>
        <record id="view_employee_form_custom_tabs" model="ir.ui.view">
            <field name="name">Custom Tabs Inherit in Employee</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='hr_settings']" position="after">
                    <!--                    <notebook>-->

                    <page string="Academic Information" name="academic_info">
                        <group string="Academic Information">
                            <field name="education_id"
                                   widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.edu_info_form'}"
                                   options="{'no_create_edit': False, 'no_create': False}"/>
                        </group>

                        <group string="Verifying Body Details">
                            <field name="verify_body_id"
                                   widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.verify_info_form'}"
                                   options="{'no_create_edit': False, 'no_create': False}"/>
                        </group>
                    </page>

                    <page string="Additional Duties" name="additional_duties">
                        <group>
                            <field name="additional_duties_emp_ids" string=" "
                                   widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.form_view_additional_duties'}"
                                   options="{'no_create': False, 'no_open': True}"/>
                        </group>
                    </page>

                    <page string="Courses Taught" name="training_courses_taught">

                        <group string="Courses">
                            <field name="training_courses_taught_ids"
                                   widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.form_view_training_courses_taught'}"
                                   options="{'no_create': False, 'no_open': True}"/>
                        </group>
                    </page>

                    <page string="Disciplinary Records" name="disciplinary_records">
                        <group>
                            <group>
                                <field name="disc_description"/>
                                <field name="disc_date"/>
                                <field name="disc_place"/>
                                <field name="disc_inquiry_headed_by"/>
                            </group>
                            <group>
                                <field name="disc_punishment_type"/>
                                <field name="disc_remarks"/>
                                <field name="disc_documents"/>
                                <field name="disc_action_type"/>
                            </group>
                        </group>
                    </page>

                    <page string="Employee Records" name="employee_records">
                        <group>
                            <field name="employee_records_ids"
                                   widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.skans_form_view_employee_records'}"
                                   options="{'no_create': False, 'no_open': True}"/>
                        </group>
                    </page>

                    <page string="Family Details" name="family_info">
                        <group string="Spouse Information" colspan="2">
                            <group>
                                <field name="sp_name" placeholder="Spouse Name"/>
                                <field name="sp_dob" placeholder="Date of birth"/>
                                <field name="sp_cnic" placeholder="CNIC No"/>
                                <field name="sp_dom" placeholder="Marriage Date"/>
                                <field name="sp_mp" placeholder="Marriage place"/>
                            </group>
                            <group>
                                <field name="sp_profession" placeholder="Profession"/>
                                <field name="sp_status"/>
                                <field name="sp_designation" placeholder="Designation"/>
                                <field name="sp_employer" placeholder="Name or Descriptions"/>
                            </group>
                        </group>

                        <group string="Child Information">
                            <field name="child_details_ids"
                                   widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.form_view_child_info'}"
                                   options="{'no_create': False, 'no_open': True}"/>
                        </group>

                    </page>

                    <page string="Financial Incentives" name="financial_incentives">

                        <group string="Increments">
                            <field name="increment_ids" readonly="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="date"/>
                                    <field name="wage" optional="hide"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </group>

                        <group string="Bonuses">
                            <field name="bonus_line_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="bonus" string="Amount"/>
                                </list>
                            </field>
                        </group>
                    </page>

                    <page string="Professional Qualification" name="professional_qualification">

                        <group string="Certification">
                            <field name="professional_details_ids"
                                   widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.form_view_professional_info'}"
                                   options="{'no_create': False, 'no_open': True}"/>
                        </group>

                        <group string="Body Verification">
                            <field name="verification_details_ids"
                                   widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.form_view_verification_info'}"
                                   options="{'no_create': False, 'no_open': True}"/>
                        </group>
                    </page>

                    <page string="Professional Registration Information" name="professional_registration">


                        <group string="Professional Registration">
                            <field name="reg_id" widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.prof_reg_info_form'}"
                                   options="{'no_create_edit': False, 'no_create': False}"/>
                        </group>

                    </page>


                    <page string="Projects Summary" name="projects_summary">
                        <group string="Projects">
                            <field name="project_employee_ids"
                                   widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.form_view_project'}"
                                   options="{'no_create': False, 'no_open': True}"/>
                        </group>
                    </page>

                    <page string="Training Courses" name="training_courses">
                        <group string="Courses">
                            <field name="training_courses_emp_ids"
                                   widget="form"
                                   context="{'form_view_ref': 'skans_employee_tabs.form_view_training_courses'}"
                                   options="{'no_create': False, 'no_open': True}"/>
                        </group>
                    </page>

                    <!--                    </notebook>-->
                </xpath>
            </field>
        </record>
    </data>
</odoo>