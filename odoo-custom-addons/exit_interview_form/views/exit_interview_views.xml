<odoo>
    <data>

        <record id="view_exit_interview_form" model="ir.ui.view">
            <field name="name">Exit Interview Form</field>
            <field name="model">exit.interview.form</field>
            <field name="arch" type="xml">
                <form string="Exit Interview Form">
                    <sheet>
                        <group>
                            <group>
                                <field name="interview_emp"/>
                                <field name="interview_emp_designation" readonly="1"/>
                                <field name="interview_emp_school_head" readonly="1"/>
                                <field name="interview_salary_package" widget="boolean_toggle"/>
                                <field name="interview_further_studies" widget="boolean_toggle"/>
                                <field name="interview_org_culture" widget="boolean_toggle"/>
                                <field name="interview_conflict_manager_employee" widget="boolean_toggle"/>
                                <field name="interview_work_load" widget="boolean_toggle"/>
                                <field name="interview_lack_fairness_promotion" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="interview_emp_number" readonly="1"/>
                                <field name="interview_emp_resign_date"/>
                                <field name="interview_emp_school_name" readonly="1"/>
                                <field name="interview_benefit_plan" widget="boolean_toggle"/>
                                <field name="interview_better_opportunity" widget="boolean_toggle"/>
                                <field name="interview_lack_growth" widget="boolean_toggle"/>
                                <field name="interview_redundant_termination" widget="boolean_toggle"/>
                                <field name="interview_training_development" widget="boolean_toggle"/>
                                <field name="interview_other_reason" widget="boolean_toggle"/>
                                <field name="interview_other_reason_text" readonly="[('interview_other_reason', '=', False)]"/>
                            </group>
                        </group>
                        <group>
                            <field name="interview_main_reason_text"/>
                            <field name="interview_suggestion_text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_exit_interview_tree" model="ir.ui.view">
            <field name="name">Exit Interview</field>
            <field name="model">exit.interview.form</field>
            <field name="arch" type="xml">
                <list>
                    <field name="interview_emp"/>
                    <field name="interview_emp_number"/>
                    <field name="interview_emp_designation"/>
                    <field name="interview_emp_resign_date"/>
                    <field name="interview_emp_school_head"/>
                    <field name="interview_emp_school_name"/>
                </list>
            </field>
        </record>

        <record id="action_exit_interview_form" model="ir.actions.act_window">
            <field name="name">Exit Interview Forms</field>
            <field name="res_model">exit.interview.form</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Exit Interview!
                </p>
            </field>
        </record>

        <menuitem id="menu_exit_interview_root" name="Exit Interview" parent="hr.menu_hr_root"/>

        <menuitem id="menu_exit_interview" name="Exit Interview" parent="menu_exit_interview_root"
                  action="action_exit_interview_form"/>
    </data>
</odoo>
