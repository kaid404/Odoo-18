<odoo>
    <data>
        <record id="skans_survey_report_form" model="ir.ui.view">
            <field name="name">Survey Report</field>
            <field name="model">survey.report</field>
            <field name="arch" type="xml">
                <form>
                    <group col="2">
                        <field name="survey_id"/>
                    </group>
                    <footer>
                        <button string="Generate Report" type="object" name="print_report"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_skans_survey_report" model="ir.actions.act_window">
            <field name="name">Survey Report</field>
            <field name="res_model">survey.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
                id="menu_skans_survey_report"
                name="Teacher evaluation with student"
                parent="survey_custom_report.menu_survey_reports_root"
                action="action_skans_survey_report"
        />
<!--                parent="point_of_sale.menu_point_rep"-->
    </data>
</odoo>
