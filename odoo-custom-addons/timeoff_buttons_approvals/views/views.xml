<odoo>
    <data>
        <record id="view_hr_leave_custom_form" model="ir.ui.view">
            <field name="name">hr.leave.form.custom</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='state']" position="replace">
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,validate1,validate"/>
                </xpath>


                <xpath expr="//button[@name='action_approve']" position="attributes">
                    <attribute name="string">Line Manager</attribute>
                </xpath>

                <xpath expr="//button[@name='action_validate']" position="attributes">
                    <attribute name="string">HR Manager</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
