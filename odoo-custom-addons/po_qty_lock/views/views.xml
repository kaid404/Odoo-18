<odoo>
    <data>

        <record id="view_move_form_quantity_lock" model="ir.ui.view">
            <field name="name">view_move_form_quantity_lock</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']//field[@name='quantity']" position="attributes">
                    <attribute name="readonly">is_quantity_editable</attribute>
                </xpath>
            </field>
        </record>


    </data>
</odoo>
