<odoo>


    <record id="gxs_timetable.view_time_table_report_form" model="ir.ui.view">
        <field name="name">time.table.report.form</field>
        <field name="model">time.table.report</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Time Table Report">
                <sheet>
                    <div>
                        <group colspan="4" cols="4">
                            <group>
                                <field name="start_date"/>
                                <field name="state" invisible="1"/>
                                <field name="faculty_id"
                                       required="state == '1'" invisible="1"/>

                                <field name="gxs_campus_id"/>
                                <field name="faculty_ids" widget="many2many_tags"/>

                                <field name="class_id"/>
                            </group>
                            <group>
                                <field name="end_date"/>
                                <!--                                    <field name="course_id"-->
                                <!--                                           required="state == 'student'" invisible="state != 'student'"/>-->
                                <!--                                    <field name="batch_id" context="{'course_id': course_id,'get_parent_batch':1}"-->
                                <!--                                           required="state == 'student'" invisible="state != 'student'"/>-->
                            </group>
                        </group>
                    </div>
                </sheet>
                <footer>
                    <span groups="base.group_user">
                        <button name="generate_pdf_report"
                                string="Teacher Timetable Report"
                                type="object"
                                class="btn-secondary"/>

                        <button name="generate_pdf_class_report"
                                string="Class Timetable Report"
                                type="object"
                                class="btn-secondary"/>
                        <button string="Print" type="object"
                                name="gen_time_table_report" class="oe_highlight"/>
                        <button special="cancel" string="Close" type="object"/>
                    </span>
                </footer>
            </form>
        </field>
    </record>

