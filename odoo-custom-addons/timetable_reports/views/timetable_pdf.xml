                        <!--                                </th>-->
                        <!--                            </t>-->
                        <!--                        </tr>-->

                    </thead>
                    <tbody>
                        <t t-foreach="days" t-as="day">
                            <t t-set="faculty_sessions" t-value="[]"/>
                            <t t-set="all_times" t-value="[]"/>

                            <!-- Collect sessions per faculty -->
                            <t t-if="doc.faculty_ids">
                                <t t-foreach="doc.faculty_ids" t-as="faculty">
                                    <t t-set="sessions" t-value="doc.get_sessions(faculty)"/>
                                    <t t-set="filtered_sessions"
                                       t-value="[s for s in sessions if s.start_datetime.strftime('%A') == day]"/>
                                    <t t-set="faculty_sessions"
                                       t-value="faculty_sessions + [(faculty, filtered_sessions)]"/>
                                    <t t-set="all_times"
                                       t-value="all_times + [s.start_datetime.strftime('%H:%M') for s in filtered_sessions]"/>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-set="sessions" t-value="doc.get_sessions()"/>
                                <t t-set="filtered_sessions"
                                   t-value="[s for s in sessions if s.start_datetime.strftime('%A') == day]"/>
                                <!-- “faculty_sessions” still used later, so we just fake a list -->
                                <t t-set="faculty_sessions" t-value="[(False, filtered_sessions)]"/>
                                <t t-set="all_times"
                                   t-value="[s.start_datetime.strftime('%H:%M') for s in filtered_sessions]"/>
                            </t>
                            <!--                            <t t-foreach="doc.faculty_ids" t-as="faculty">-->
                            <!--                                <t t-set="sessions" t-value="doc.get_sessions(faculty)"/>-->
                            <!--                                <t t-set="filtered_sessions"-->
                            <!--                                   t-value="[s for s in sessions if s.start_datetime.strftime('%A') == day]"/>-->
                            <!--                                <t t-set="faculty_sessions"-->
                            <!--                                   t-value="faculty_sessions + [(faculty, filtered_sessions)]"/>-->
                            <!--                                <t t-set="all_times"-->
                            <!--                                   t-value="all_times + [s.start_datetime.strftime('%H:%M') for s in filtered_sessions]"/>-->
                            <!--                            </t>-->

                            <t t-set="unique_times" t-value="sorted(set(all_times))"/>
                            <t t-set="row_index" t-value="1"/>

                            <t t-foreach="unique_times" t-as="time" t-foreach-index="time_index">
                                <tr>
                                    <!-- Vertical Day only once -->
                                    <t t-if="time_index == 0">
                                        <td style="border: 1px solid black; padding: 5px; font-weight: bold; text-align: center;"
                                            t-att-rowspan="len(unique_times)">
                                            <t t-foreach="day.upper()" t-as="char">
                                                <t t-esc="char"/>
                                                <br/>
                                            </t>
                                        </td>
                                    </t>

                                    <!-- Period number -->
                                    <td style="border: 1px solid black; padding: 5px; text-align: center;">
                                        <t t-esc="row_index"/>
                                    </td>

                                    <!-- Subject per teacher -->
                                    <t t-foreach="faculty_sessions" t-as="fs">
                                        <t t-set="matched_sessions"
                                           t-value="[s for s in fs[1] if s.start_datetime.strftime('%H:%M') == time]"/>
                                        <td style="border: 1px solid black; padding: 5px; text-align: center;">
                                            <t t-if="matched_sessions">
                                                <t t-set="s" t-value="matched_sessions[0]"/>
                                                <div>
                                                    <t t-esc="s.subject_id.name"/>
                                                    <br/>
                                                    <t t-if="s.section_id">
                                                        <span style="font-size: 10px; color: #666;">
                                                            <t t-esc="s.section_id.class_id.name"/>
                                                            -
                                                            <t t-esc="s.section_id.name"/>
                                                        </span>
                                                    </t>
                                                </div>
                                            </t>
                                        </td>
                                    </t>
                                </tr>
                                <t t-set="row_index" t-value="row_index + 1"/>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
