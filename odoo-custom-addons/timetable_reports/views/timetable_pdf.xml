    <record id="paperformat_class_teacher" model="report.paperformat">
        <field name="name">Teacher And Class Timetable</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <!-- ✅ Report Action -->
    <record id="action_faculty_timetable_pdf_report" model="ir.actions.report">
        <field name="name">Teacher Timetable PDF</field>
        <field name="model">time.table.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">timetable_reports.report_faculty_timetable_pdf</field>
        <field name="report_file">timetable_reports.report_faculty_timetable_pdf</field>
        <field name="paperformat_id" ref="timetable_reports.paperformat_class_teacher"/>
        <field name="print_report_name">'Faculty_Timetable_%s' % (object.id)</field>
    </record>
    <record id="action_faculty_class_timetable_pdf_report" model="ir.actions.report">
        <field name="name">Class Timetable PDF</field>
        <field name="model">time.table.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">timetable_reports.report_class_faculty_timetable_pdf</field>
        <field name="report_file">timetable_reports.report_class_faculty_timetable_pdf</field>
        <field name="paperformat_id" ref="timetable_reports.paperformat_class_teacher"/>
        <field name="print_report_name">'Faculty_Timetable_%s' % (object.id)</field>
    </record>

    <record id="your_custom_session_form_view" model="ir.ui.view">
        <field name="name">op.session.form.inherit.section</field>
        <field name="model">op.session</field>
        <field name="inherit_id" ref="gxs_timetable.view_op_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='subject_id']" position="after">
                <field name="section_id"/>
                <field name="class_name"/>
            </xpath>
        </field>
    </record>
    <record id="your_custom_session_list_view" model="ir.ui.view">
        <field name="name">op.session.list.inherit.section</field>
        <field name="model">op.session</field>
        <field name="inherit_id" ref="gxs_timetable.view_op_session_search"/>  <!-- original list view ID -->
        <field name="arch" type="xml">
            <xpath expr="//field[@name='subject_id']" position="after">
                <field name="section_id"/>
                <field name="class_name"/>
            </xpath>
        </field>
    </record>
