            <t t-set="days" t-value="['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']"/>

            <div class="page">
                <h3 style="text-align: center;">Teacher Timetable (C2)</h3>


                <table style="font-size:11px; border-collapse: collapse; width:100%;">
                    <thead>
                        <tr>
                            <th style="border: 1px solid black; padding: 5px;" colspan="2">Class Teacher</th>

                            <t t-if="doc.faculty_ids">
                                <t t-foreach="doc.faculty_ids" t-as="faculty">
                                    <th style="border: 1px solid black; padding: 5px; padding-left: 15px;">
                                        <t t-esc="faculty.teacher_unique_code"/>
                                    </th>
                                </t>
                            </t>

                            <t t-else="">
                                <t t-set="sessions" t-value="doc.get_sessions()"/>
                                <t t-set="faculties"
                                   t-value="sorted(set([s.faculty_id for s in sessions if s.faculty_id]), key=lambda f: f.name)"/>
                                <t t-foreach="faculties" t-as="faculty">
                                    <th style="border: 1px solid black; padding: 5px; padding-left: 15px;">
                                        <t t-esc="faculty.teacher_unique_code"/>
                                    </th>
                                </t>
                            </t>
                        </tr>

                        <tr>
                            <th style="border: 1px solid black; padding: 5px;" colspan="2">Class</th>

                            <t t-if="doc.faculty_ids">
                                <t t-foreach="doc.faculty_ids" t-as="faculty">
                                    <th style="border: 1px solid black; padding: 5px;">
                                        <t t-set="section"
                                           t-value="env['class.section'].search([('faculty', '=', faculty.id)], limit=1)"/>
                                        <t t-if="section">
                                            <t t-esc="section.class_id.name"/>
                                            /
                                            <t t-esc="section.name"/>
                                        </t>
                                    </th>
                                </t>
                            </t>

                            <t t-else="">
                                <t t-set="sessions" t-value="doc.get_sessions()"/>
                                <t t-set="faculties"
                                   t-value="sorted(set([s.faculty_id for s in sessions if s.faculty_id]), key=lambda f: f.name)"/>
                                <t t-foreach="faculties" t-as="faculty">
                                    <th style="border: 1px solid black; padding: 5px;">
                                        <t t-set="section"
                                           t-value="env['class.section'].search([('faculty', '=', faculty.id)], limit=1)"/>
                                        <t t-if="section">
                                            <t t-esc="section.class_id.name"/>
                                            /
                                            <t t-esc="section.name"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="doc.class_id.name"/>
                                        </t>
                                    </th>
                                </t>
                            </t>
                        </tr>
                        <!--                        <tr>-->
                        <!--                            <th style="border: 1px solid black; padding: 5px;" colspan="2">Class Teacher</th>-->
                        <!--                            <t t-foreach="doc.faculty_ids" t-as="faculty">-->
                        <!--                                <th style="border: 1px solid black; padding: 5px; padding-left: 15px;">-->
                        <!--                                    &lt;!&ndash;                                    <t t-esc="faculty.name"/>&ndash;&gt;-->
                        <!--                                    <t t-esc="faculty.teacher_unique_code"/>-->
                        <!--                                </th>-->
                        <!--                            </t>-->
                        <!--                        </tr>-->

                        <!--                        <tr>-->
                        <!--                            <th style="border: 1px solid black; padding: 5px;" colspan="2">Class</th>-->
                        <!--                            <t t-foreach="doc.faculty_ids" t-as="faculty">-->
                        <!--                                <th style="border: 1px solid black; padding: 5px;">-->
                        <!--                                    <t t-set="section"-->
                        <!--                                       t-value="env['class.section'].search([('faculty', '=', faculty.id)], limit=1)"/>-->
