<odoo>
    <data>
        <record id="button_inherit" model="ir.ui.view">
            <field name="name">approval.button.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[15]" position="after">
                    <button name="confirm_finance_button" string="Finance Approval" id="finance_approval_button"
                            invisible="show_finance_btn"
                            groups="skans_po_and_vendor_approval.finance_approval"
                            type="object" class="btn-secondary"/>
                    <button name="confirm_executive_button" string="Executive Approval" id="director_approval_button"
                            invisible="show_executive_director_btn"
                            groups="skans_po_and_vendor_approval.executive_approval"
                            type="object" class="btn-secondary"/>
                    <button name="confirm_ceo_button" string="CEO Approval" id="ceo_approval_button"
                            invisible="show_ceo_btn"
                            groups="skans_po_and_vendor_approval.ceo_approval"
                            type="object" class="btn-secondary"/>
                </xpath>

                <xpath expr="//field[@name='state']" position="replace">
                    <field name="state" widget="statusbar" statusbar_visible="draft,finance,executive,ceo,sent,purchase"
                           readonly="1"/>

                </xpath>
            </field>
        </record>

        <record id="confirm_button_attr_inherit" model="ir.ui.view">
            <field name="name">confirm.button.attr.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//button[@id='draft_confirm'][1]" position="attributes">
                    <attribute name="invisible">state not in ['finance','executive','ceo']</attribute>
                </xpath>

                <xpath expr="//button[@name='button_cancel']" position="attributes">
                    <attribute name="invisible">state not in ['sent', 'finance', 'executive', 'ceo']</attribute>
                </xpath>


                <xpath expr="//button[@name='button_draft']" position="attributes">
                    <attribute name="invisible">state not in ['sent', 'finance', 'executive', 'ceo']</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
