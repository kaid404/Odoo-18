<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_move_tree_inherit_payment_info" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.payment.info</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="payment_date"/>
                <field name="payment_journal_id"/>
            </xpath>
        </field>
    </record>

    <record id="bill_tree_inherit_payment_info" model="ir.ui.view">
        <field name="name">bill.tree.inherit.payment.info</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="payment_date"/>
                <field name="payment_journal_id"/>
            </xpath>
        </field>
    </record>
</odoo>