<odoo>
    <record id="view_hr_applicant_form_custom" model="ir.ui.view">
        <field name="name">hr.applicant.form.institute</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_name']" position="after">
                <field name="institute_type" required="1" readonly="first_approved"/>
                <field name="first_approved" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

               <xpath expr="//header" position="inside">
                <button name="action_approve_next_stage"
                        type="object"
                        class="btn btn-primary"
                        invisible="show_dynamic_button ==  False">
                    <field name="dynamic_button_label" readonly="1" widget="label"/>
                </button>
            </xpath>

        </field>
    </record>
</odoo>
