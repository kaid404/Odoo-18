<odoo>

    <template id="monthly_att_report_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <h2>Attendance Report</h2>

                    <table class="table table-bordered" style="width:100%; text-align:center;">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <t t-foreach="date_list" t-as="dt">
                                    <th>
                                        <t t-esc="dt.split('-')[2]"/>
                                    </th>
                                </t>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="attendance_data.items()" t-as="student_data">
                                <tr>
                                    <td>
                                        <t t-esc="student_data[0]"/>
                                    </td>

                                    <t t-foreach="date_list" t-as="dt">
                                        <td>
                                            <t t-esc="student_data[1].get(dt)"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>


        <record id="paperformat_monthly_att_report" model="report.paperformat">
            <field name="name">Monthly Attendance Report Paper Format</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">8</field>
            <field name="margin_right">8</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">5</field>
            <field name="dpi">90</field>
        </record>

    <record id="monthly_att_report_action" model="ir.actions.report">
        <field name="name">Monthly Attendance Report</field>
        <field name="model">monthly.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">monthly_att_report.monthly_att_report_template</field>
        <field name="report_file">monthly_att_report.monthly_att_report_template</field>
            <field name="paperformat_id" ref="paperformat_monthly_att_report"/>
    </record>

</odoo>
