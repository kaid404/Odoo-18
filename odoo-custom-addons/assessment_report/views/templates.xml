<odoo>
    <data>
        <template id="assessments_report_template">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <h3 style="text-align:center; margin-bottom: 15px;">Assessment Report</h3>

                        <div style="margin-bottom: 20px;">
                            <p>
                                <strong>Term:</strong>
                                <t t-esc="term"/>
                            </p>
                            <p>
                                <strong>Class:</strong>
                                <t t-esc="class"/>
                            </p>
                            <p>
                                <strong>Assignment:</strong>
                                <t t-esc="assignment"/>
                            </p>
                            <p>
                                <strong>Printed By:</strong>
                                <t t-esc="printed_by"/>
                            </p>
                            <p>
                                <strong>Report Date:</strong>
                                <t t-esc="report_date"/>
                            </p>
                        </div>

                        <table class="table table-bordered">
                            <thead>
                                <th>Name</th>
                                <th>Total Marks</th>
                                <th>Obtained Marks</th>
                                <th>Percentage</th>
                                <th>Status</th>
                            </thead>
                            <tbody>
                                <t t-foreach="students" t-as="st">
                                    <tr>
                                        <td>
                                            <t t-esc="st['name']"/>
                                        </td>
                                        <td>
                                            <t t-esc="st['total_marks']"/>
                                        </td>
                                        <td>
                                            <t t-esc="st['obt_marks']"/>
                                        </td>
                                        <td>
                                            <t t-esc="'%.2f' % st['percentage']"/>
                                        </td>
                                        <td>
                                            <t t-esc="st['grade']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div style="margin-top: 25px;">
                            <p>
                                <strong>Total Students:</strong>
                                <t t-esc="total_st"/>
                            </p>
                            <p>
                                <strong>Passed Students: </strong>
                                <t t-esc="passed_st"/>
                            </p>
                            <p>
                                <strong>Failed Students: </strong>
                                <t t-esc="failed_st"/>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <record id="action_report_assessments" model="ir.actions.report">
            <field name="name">Assessments Report</field>
            <field name="model">assessment.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">assessment_report.assessments_report_template</field>
            <field name="report_file">assessment_report.assessments_report_template</field>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
