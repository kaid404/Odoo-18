<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gxs_section_transfer_form_view_cl" model="ir.ui.view">
        <field name="name">gxs.class.transfer</field>
        <field name="model">gxs.class.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Reset to draft" class="oe_highlight" type="object"
                            name="action_reset_draft" invisible="state not in ['refuse']"/>
                    <button string="Refuse" class="btn-danger"
                            invisible="state not in ['draft']" type="object"
                            name="action_refuse"/>
                    <button string="Transfer" class="oe_highlight" type="object"
                            name="action_confirm" invisible="state not in ['draft']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,refuse,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" readonly="state in 'done'"/>
                            <field name="class_id" force_save="1"/>
                            <field name="new_class_id" force_save="1"/>
                        </group>
                        <group>
                            <field name="new_section_id" readonly="state in 'done'"/>
                            <field name="reason" readonly="state in 'done'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="gxs_section_transfer_list_view_cl" model="ir.ui.view">
        <field name="name">gxs.class.transfer.list</field>
        <field name="model">gxs.class.transfer</field>
        <field name="arch" type="xml">
            <list string="Student Transfer"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'refuse'">
                <field name="student_id"/>
                <field name="section_id"/>
                <field name="new_section_id"/>
                <field name="reason"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <record id="action_gxs_section_transfer_cl" model="ir.actions.act_window">
        <field name="name">Student Transfer</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">gxs.class.transfer</field>
        <field name="view_mode">form,list</field>
        <field name="view_id" ref="gxs_section_transfer_list_view_cl"/>
    </record>

    <menuitem id="student_section_transfer_menucl"
              name="Students Class Transfer"
              parent="gxs_core.menu_op_student_root"
              sequence="150"/>

    <menuitem id="student_transfer_section_menu_childcl"
              name="Students Class Transfer"
              parent="student_section_transfer_menucl"
              action="action_gxs_section_transfer_cl"
              sequence="1"/>


</odoo>
