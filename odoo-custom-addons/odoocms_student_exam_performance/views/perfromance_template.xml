<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="odoocms_performance_template_form" model="ir.ui.view">
        <field name="name">odoocms.performance.template.form</field>
        <field name="model">odoocms.performance.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
<!--                            <field name="section_id"/>-->
                        </group>
                        <group>
                           <field name="code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Performance Types">
                            <field name="performance_template_line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="performance_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_odoocms_performance_template" model="ir.actions.act_window">
        <field name="name">Performance Template</field>
        <field name="res_model">odoocms.performance.template</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>


    <record id="odoocms_performance_template_tree" model="ir.ui.view">
        <field name="name">odoocms.performance.template.list</field>
        <field name="model">odoocms.performance.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <menuitem
            id="performance_template_menu"
            parent="odoocms_academic.menu_odoocms_academic_configuration"
            name="Performance Template"
            action="action_odoocms_performance_template"
            sequence="30"/>


</odoo>