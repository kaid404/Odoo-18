<odoo>

     <record id="view_grade_summary_report_form" model="ir.ui.view">
        <field name="name">Grade Summary</field>
        <field name="model">grade.summary.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="class_id"/>
<!--                    <field name="campus_id"/>-->
                </group>
                <footer>
                        <button string="Generate Report" type="object" name="print_grade_summary_report"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
            </form>
        </field>
    </record>


     <record id="grade_summary_report_action" model="ir.actions.act_window">
        <field name="name">Grade Summary</field>
        <field name="res_model">grade.summary.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

      <menuitem id="menu_grade_summary_report" name="grade summary report" action="grade_summary_report_action"
              parent="senior_result_report.results_reporting_root"/>





</odoo>