<odoo>
    <record id="view_employee_bonus_form" model="ir.ui.view">
        <field name="name">employee.bonus.form</field>
        <field name="model">employee.bonus</field>
        <field name="arch" type="xml">
            <form string="Employee Bonus">
                <header>
                    <button string="Half Bonus" type="object" name="action_half_bonus" invisible="state != 'draft'"
                            groups="skan_employee_bonus.group_half_bonus" class="btn btn-primary"/>
                    <button string="Full Bonus" type="object" name="action_full_bonus" invisible="state != 'draft'"
                            groups="skan_employee_bonus.group_full_bonus" class="btn btn-primary"/>
                    <button string="HOD Approval" type="object" name="action_coo_approval"
                            invisible="state != 'fina_approval'" class="btn btn-primary"
                            groups="skan_employee_bonus.group_coo_approval"/>
                    <button string="Reset to Draft" type="object" name="action_reset_to_draft"
                            invisible="state != 'done'" class="btn btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="date" readonly="state == 'done'"/>
                        <field name="bonus_type" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Employee Lines">
                            <field name="employee_lines">
                                <list>
                                    <field name="badge_id"/>
                                    <field name="employee_id"/>
                                    <field name="work_location"/>
                                    <field name="contract_start_date"/>
                                    <field name="employee_status"/>
                                    <field name="wage"/>
                                    <field name="bonus"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="badge_id"/>
                                            <field name="employee_id"/>
                                            <field name="work_location"/>
                                        </group>
                                        <group>
                                            <field name="contract_start_date"/>
                                            <field name="employee_status"/>
                                            <field name="wage"/>
                                            <field name="bonus"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                            <group>
                                <field name="total_employees" readonly="1"/>
                                <field name="gross_total" readonly="1"/>
                                <field name="bonus_total" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_employee_bonus_list" model="ir.ui.view">
        <field name="name">employee.bonus.list</field>
        <field name="model">employee.bonus</field>
        <field name="arch" type="xml">
            <list string="Employee Bonuses">
                <field name="name"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_employee_bonus" model="ir.actions.act_window">
        <field name="name">Employee Bonus</field>
        <field name="res_model">employee.bonus</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_employee_bonus_list"/>
    </record>

    <menuitem id="menu_employee_bonus" name="Bonus" parent="hr_work_entry_contract_enterprise.menu_hr_payroll_root"
              action="action_employee_bonus"/>
</odoo>