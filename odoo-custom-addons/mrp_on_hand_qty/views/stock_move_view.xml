<data>


    <record id="view_picking_form_inherit_mrp" model="ir.ui.view">
        <field name="name">stock.picking.form.on.hand</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page[@name='operations']/field[@name='move_ids_without_package']/list/field[@name='quantity']"
                   position="after">
                <field name="on_hand_qty" readonly="1"/>
            </xpath>

        </field>
    </record>


    <record id="mrp_view_form_inherit_on_hand_qty" model="ir.ui.view">
        <field name="name">mrp.production.on_hand_qty</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page[@name='components']/field[@name='move_raw_ids']/list/field[@name='location_id']"
                   position="after">
                <field name="on_hand_qty" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_on_hand_qty" model="ir.ui.view">
        <field name="name">purchase_order_on_hand_qty</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page[@name='products']/field[@name='order_line']/list/field[@name='product_id']"
                   position="after">
                <field name="on_hand_qty" readonly="1"/>
            </xpath>
        </field>
    </record>

