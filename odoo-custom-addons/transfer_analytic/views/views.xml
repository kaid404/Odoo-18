<odoo>
  <data>
    <record id="consumption_view_form_inherit_analytic" model="ir.ui.view">
        <field name="name">consumption_view_form_inherit_analytic</field>
        <field name="model">transfer.consumption</field>
        <field name="inherit_id" ref="consumption.view_transfer_consumption_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='line_ids']/list/field[@name='product_id']" position="after">
                <field name="product_uom_id"/>
                <field name="analytic_distribution" widget="analytic_distribution"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='dest_location_id']" position="after">
                <field name="remarks"/>
            </xpath>
        </field>
    </record>
  </data>
</odoo>
