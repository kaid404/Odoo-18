<odoo>

    <menuitem
            name="Update Apps List"
            action="base.action_view_base_module_update"
            id="menu_view_base_module_update"

            sequence="40"/>


    <record id="view_faculty_result_summary_wizard" model="ir.ui.view">
        <field name="name">faculty.result.summary.wizard.form</field>
        <field name="model">faculty.result.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Faculty Result Summary">
                <group>
                    <field name="academic_term_ids"/>
                    <field name="campus_name"/>
                </group>
                <footer>
                    <button string="Print Report" type="object" name="action_print_report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_faculty_result_summary_wizard" model="ir.actions.act_window">
        <field name="name">Faculty Result Summary</field>
        <field name="res_model">faculty.result.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_faculty_result_summary_root"
              name="Faculty Reports"
              sequence="10"/>

    <menuitem id="menu_faculty_result_summary"
              name="Faculty Result Summary"
              parent="menu_faculty_result_summary_root"
              action="action_faculty_result_summary_wizard"/>


</odoo>