<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_budget_config_tree" model="ir.ui.view">
        <field name="name">employee.budget.config.tree</field>
        <field name="model">employee.loan.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="department_id"/>
                <field name="budget"/>
                <field name="consumed_budget"/>
                <field name="remaining_budget"/>
            </list>
        </field>
    </record>

    <record id="view_employee_budget_config_form" model="ir.ui.view">
        <field name="name">employee.budget.config.form</field>
        <field name="model">employee.loan.budget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h4>
                        <field name="name"/>
                    </h4>
                    <group>
                        <field name="company_id"/>
                        <field name="department_id" widget="many2many_tags"/>
                        <field name="budget"/>
                        <field name="consumed_budget"/>
                        <field name="remaining_budget"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_employee_budget_config" model="ir.actions.act_window">
        <field name="name">Employee Budget Configuration</field>
        <field name="res_model">employee.loan.budget</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_employee_budget_config_root"
              name="Loan/ Adv Budget"
              parent="hr.menu_human_resources_configuration"
              sequence="100"
              action="action_employee_budget_config"/>

    <record id="seq_employee_loan_budget" model="ir.sequence">
        <field name="name">Employee Loan Budget</field>
        <field name="code">employee.loan.budget</field>
        <field name="prefix">BUDG-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>