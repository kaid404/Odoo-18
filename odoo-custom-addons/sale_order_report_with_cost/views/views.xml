<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cost_view" model="ir.ui.view">
        <field name="name">Sale order inherit form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook/page/field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="standard_cost2"/>
                <field name="cost_order_line" sum="total"/>
            </xpath>
        </field>
    </record>


</odoo>